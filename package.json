{
  "name": "mobileproof-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auditable local smoke and capability verification for React Native applications.",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm build && pnpm release:check && pnpm typecheck && pnpm lint && pnpm test && pnpm docs:check && pnpm security:audit",
    "docs:check": "node scripts/check-doc-links.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "security:audit": "node scripts/check-audit.mjs",
    "release:check": "node scripts/check-package-versions.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.16.1",
    "fast-glob": "^3.3.3",
    "search-insights": "2.17.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.15"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "keywords": [],
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongan69/mobileproof.git"
  },
  "bugs": {
    "url": "https://github.com/jongan69/mobileproof/issues"
  },
  "homepage": "https://github.com/jongan69/mobileproof#readme"
}
