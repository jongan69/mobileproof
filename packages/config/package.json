{
  "name": "@mobileproof/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/mobileproof.schema.json"
  },
  "files": ["dist", "schema"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && cp -R schema dist/schema",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  }
}
